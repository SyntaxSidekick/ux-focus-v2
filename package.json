{
  "name": "uxfocus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "desktop": "electron .",
    "desktop:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "docker:build": "docker build -t ux-focus-v2:local .",
    "docker:up": "node scripts/docker-start.mjs",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows-startup.ps1",
    "test": "node scripts/test.mjs"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@popperjs/core": "2.11.8",
    "canvas-confetti": "1.9.4",
    "date-fns": "3.6.0",
    "electron": "31.7.7",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-popper": "2.3.0",
    "react-responsive-masonry": "2.7.1",
    "react-router": "7.13.0",
    "react-slick": "0.31.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.5",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5",
    "wait-on": "9.1.0"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
